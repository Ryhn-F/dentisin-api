{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dentisai.local/triage/input.schema.json",
  "title": "Triage engine input (rules 0.2.0-draft)",
  "description": "Generated from rules.yaml by triage.export. Detections carry only class + confidence: box geometry is NOT an engine input (ADR 014; strip boxes used for the UI overlay before calling the engine). Cross-field rule enforced by the engine: detections require an assessed photo.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "detections",
    "photo_status",
    "symptoms",
    "age_months",
    "pain"
  ],
  "properties": {
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "class",
          "confidence"
        ],
        "properties": {
          "class": {
            "enum": [
              "caries_permanent",
              "caries_primary"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "photo_status": {
      "enum": [
        "assessed",
        "not_taken",
        "quality_failed"
      ]
    },
    "symptoms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "airway_or_swallowing",
        "lethargy",
        "trismus",
        "facial_swelling",
        "fever_with_toothache",
        "pus_or_fistula",
        "dental_trauma",
        "night_pain",
        "white_spot"
      ],
      "properties": {
        "airway_or_swallowing": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "lethargy": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "trismus": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "facial_swelling": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "fever_with_toothache": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "pus_or_fistula": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "dental_trauma": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "night_pain": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "white_spot": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        }
      }
    },
    "age_months": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        }
      ]
    },
    "pain": {
      "oneOf": [
        {
          "const": "unknown"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      ]
    }
  }
}
