{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dentisai.invalid/schemas/brushing_session_labels/0.1.0",
  "title": "DentisAI brushing session: landmark features + observer labels",
  "description": "One brushing session as per-frame LANDMARK-DERIVED FEATURES plus observer labels. Contains no video, no frames/pixels and no raw face mesh. Collect real-child data only after KEPK approval and parental consent (see label_format.md).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "subject",
    "consent",
    "recording",
    "privacy",
    "observers",
    "frames",
    "segments"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "session_id": { "type": "string", "format": "uuid", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pseudonym_id", "subject_type", "age_band"],
      "properties": {
        "pseudonym_id": {
          "type": "string",
          "description": "Random pseudonym (e.g. UUID). Never a name, NIK, initials or school roster number.",
          "pattern": "^[A-Za-z0-9_-]{8,64}$"
        },
        "subject_type": { "enum": ["adult_volunteer", "child"] },
        "age_band": { "enum": ["adult", "6-8", "9-12", "13-17"] }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consent_text_version", "consent_types", "guardian_consent", "assent", "collected_at_utc", "ethics_approval_ref"],
      "properties": {
        "consent_text_version": {
          "type": "string",
          "description": "Id of the consent text shown (see docs/regulatory/CONSENT_TEXT_DRAFT.md).",
          "minLength": 1,
          "maxLength": 64
        },
        "consent_types": {
          "type": "array",
          "description": "Granular consents given: a = local storage, b = pseudonymised technical data, c = photo upload (not used by this format).",
          "items": { "enum": ["a", "b", "c"] },
          "uniqueItems": true
        },
        "guardian_consent": { "type": "boolean", "description": "Parent/guardian consent recorded (children)." },
        "assent": { "type": ["boolean", "null"], "description": "Child assent; null for adults." },
        "collected_at_utc": { "type": "string", "format": "date-time" },
        "ethics_approval_ref": {
          "type": ["string", "null"],
          "description": "KEPK approval reference. Mandatory for children.",
          "maxLength": 128
        }
      }
    },
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "required": ["camera", "mirrored_preview", "nominal_fps", "device_class", "extractor", "started_utc"],
      "properties": {
        "camera": { "const": "front" },
        "mirrored_preview": { "const": true, "description": "x coordinates are in the mirrored preview (what the child sees)." },
        "nominal_fps": { "type": "number", "exclusiveMinimum": 0, "maximum": 120 },
        "device_class": { "enum": ["low", "mid", "high", "unknown"], "description": "Coarse class only; no IMEI/serial." },
        "extractor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 64 },
            "version": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        },
        "started_utc": { "type": "string", "format": "date-time" }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_video", "contains_frames", "contains_raw_face_mesh"],
      "properties": {
        "contains_video": { "const": false },
        "contains_frames": { "const": false },
        "contains_raw_face_mesh": { "const": false }
      }
    },
    "observers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observer_id", "role"],
        "properties": {
          "observer_id": { "type": "string", "pattern": "^OBS-[0-9]{2,4}$" },
          "role": { "enum": ["dentist", "trained_observer", "other"] }
        }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/frame" }
    },
    "segments": {
      "type": "array",
      "items": { "$ref": "#/$defs/segment" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "subject": { "properties": { "subject_type": { "const": "child" } } } } },
      "then": {
        "properties": {
          "consent": {
            "properties": {
              "guardian_consent": { "const": true },
              "assent": { "const": true },
              "ethics_approval_ref": { "type": "string", "minLength": 1 },
              "consent_types": { "contains": { "const": "b" } }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "unit": { "type": "number", "minimum": -0.5, "maximum": 1.5 },
    "point": {
      "type": ["array", "null"],
      "items": { "$ref": "#/$defs/unit" },
      "minItems": 2,
      "maxItems": 2
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "t_ms",
        "face_present",
        "face_conf",
        "face_scale",
        "mouth_center",
        "head_yaw_deg",
        "head_pitch_deg",
        "hand_present",
        "hand_conf",
        "hand_center"
      ],
      "properties": {
        "t_ms": { "type": "integer", "minimum": 0, "description": "Milliseconds since session start (monotonic)." },
        "face_present": { "type": "boolean" },
        "face_conf": { "type": "number", "minimum": 0, "maximum": 1 },
        "face_scale": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 2, "description": "Face height in normalised image units." },
        "mouth_center": { "$ref": "#/$defs/point" },
        "head_yaw_deg": { "type": ["number", "null"], "minimum": -180, "maximum": 180, "description": "Positive = head turned toward the right of the mirrored preview." },
        "head_pitch_deg": { "type": ["number", "null"], "minimum": -90, "maximum": 90, "description": "Positive = chin down." },
        "hand_present": { "type": "boolean" },
        "hand_conf": { "type": "number", "minimum": 0, "maximum": 1 },
        "hand_center": { "$ref": "#/$defs/point" }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observer_id", "start_ms", "end_ms", "is_brushing", "sextant"],
      "properties": {
        "observer_id": { "type": "string", "pattern": "^OBS-[0-9]{2,4}$" },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 0 },
        "is_brushing": { "type": "boolean", "description": "Observer judges the child to be actively brushing in this interval." },
        "sextant": {
          "enum": ["upper_left", "upper_front", "upper_right", "lower_left", "lower_front", "lower_right", "none", "unknown"],
          "description": "Left/right as seen on the mirrored preview. 'none' when not brushing; 'unknown' when the observer cannot tell."
        },
        "uncertain": { "type": "boolean" }
      },
      "if": { "properties": { "is_brushing": { "const": false } } },
      "then": { "properties": { "sextant": { "const": "none" } } },
      "else": { "properties": { "sextant": { "not": { "const": "none" } } } }
    }
  }
}
