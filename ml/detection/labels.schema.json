{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dentisai.local/ml/detection/labels.schema.json",
  "title": "DentisAI model bundle labels.json (contract ml -> app)",
  "description": "Everything the app needs to run model.tflite and decode its outputs. Decode algorithms: ml/detection/DECODE_SPEC.md; reference implementation: ml/detection/decode.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model", "validation_status", "intended_use", "distribution", "classes", "input", "output", "thresholds", "licenses", "attribution", "decode_spec"],
  "$defs": {
    "quant": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["scale", "zero_point"],
      "properties": {"scale": {"type": "number", "exclusiveMinimum": 0}, "zero_point": {"type": "integer"}}
    },
    "tensor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "role", "shape", "dtype", "quantization"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "name": {"type": ["string", "null"]},
        "role": {"enum": ["raw", "raw_boxes", "raw_scores", "boxes", "classes", "scores", "count", "logits"]},
        "shape": {"type": "array", "items": {"type": "integer"}},
        "dtype": {"enum": ["float32", "int8", "uint8"]},
        "quantization": {"$ref": "#/$defs/quant"}
      }
    },
    "license_entry": {
      "type": "object",
      "required": ["license", "verified", "source"],
      "properties": {
        "license": {"type": ["string", "null"]},
        "verified": {"type": "boolean"},
        "source": {"type": ["string", "null"]}
      }
    },
    "decode_yolox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "strides", "sigmoid_applied", "row_order", "box_formula", "score_formula"],
      "properties": {
        "type": {"const": "yolox_raw"},
        "strides": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 1},
        "sigmoid_applied": {"type": "boolean"},
        "row_order": {"const": "stride_major_then_y_then_x"},
        "box_formula": {"type": "string"},
        "score_formula": {"type": "string"}
      }
    },
    "decode_ssd_raw": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "anchors", "anchor_format", "scales", "box_order", "score_activation", "background_class"],
      "properties": {
        "type": {"const": "ssd_raw_anchors"},
        "anchors": {"type": "array", "items": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4}, "minItems": 1},
        "anchor_format": {"const": "ycenter_xcenter_h_w_normalized"},
        "scales": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}, "minItems": 4, "maxItems": 4},
        "box_order": {"enum": ["yxhw", "xywh"]},
        "score_activation": {"enum": ["sigmoid", "softmax", "none"]},
        "background_class": {"type": "boolean"}
      }
    },
    "decode_ssd_post": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "box_format", "class_id_offset"],
      "properties": {
        "type": {"const": "ssd_postprocessed"},
        "box_format": {"const": "ymin_xmin_ymax_xmax_normalized"},
        "class_id_offset": {"type": "integer"}
      }
    },
    "decode_detr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "box_format", "score_activation"],
      "properties": {
        "type": {"const": "detr_raw"},
        "box_format": {"const": "cx_cy_w_h_normalized"},
        "score_activation": {"const": "sigmoid"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "candidate", "variant", "created_at", "sha256"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"},
        "candidate": {"type": "string"},
        "variant": {"type": "string"},
        "created_at": {"type": "string"},
        "run_id": {"type": ["string", "null"]},
        "eval_report_sha256": {"type": ["string", "null"]},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256 of model.tflite"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "int8": {"type": "boolean"}
      }
    },
    "validation_status": {"enum": ["NOT_VALIDATED", "INTERNAL_EVAL_ONLY", "VALIDATED"]},
    "intended_use": {"const": "screening_only"},
    "distribution": {"enum": ["internal_experiment_only", "pilot", "release"]},
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "may_raise_triage_level", "ui_label_key"],
        "properties": {
          "id": {"type": "integer", "minimum": 0},
          "name": {"enum": ["caries_cavitated", "caries_noncavitated"]},
          "may_raise_triage_level": {"type": "boolean"},
          "ui_label_key": {"type": "string"}
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "channels", "layout", "color_order", "dtype", "normalization", "quantization", "resize"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "channels": {"const": 3},
        "layout": {"const": "NHWC"},
        "color_order": {"enum": ["RGB", "BGR"]},
        "dtype": {"enum": ["float32", "int8", "uint8"]},
        "normalization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pixel_range", "mean", "std", "formula"],
          "properties": {
            "pixel_range": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
            "mean": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
            "std": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}, "minItems": 3, "maxItems": 3},
            "formula": {"type": "string"}
          }
        },
        "quantization": {"$ref": "#/$defs/quant"},
        "resize": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "align", "pad_value", "interpolation"],
          "properties": {
            "method": {"enum": ["letterbox", "stretch"]},
            "align": {"enum": ["top_left", "center", "none"]},
            "pad_value": {"type": ["integer", "null"], "minimum": 0, "maximum": 255},
            "interpolation": {"enum": ["bilinear", "nearest", "area"]}
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "tensors", "tensors_verified", "decode", "postprocess"],
      "properties": {
        "format": {"enum": ["yolox_raw", "ssd_raw_anchors", "ssd_postprocessed", "detr_raw"]},
        "tensors": {"type": "array", "items": {"$ref": "#/$defs/tensor"}, "minItems": 1},
        "tensors_verified": {"type": "boolean", "description": "true only if shapes/dtypes were read from the .tflite by an interpreter"},
        "decode": {"oneOf": [
          {"$ref": "#/$defs/decode_yolox"}, {"$ref": "#/$defs/decode_ssd_raw"},
          {"$ref": "#/$defs/decode_ssd_post"}, {"$ref": "#/$defs/decode_detr"}
        ]},
        "postprocess": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nms_iou_threshold", "class_agnostic_nms", "max_detections", "status"],
          "properties": {
            "nms_iou_threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "class_agnostic_nms": {"type": "boolean"},
            "max_detections": {"type": "integer", "minimum": 1},
            "status": {"enum": ["technical_default", "tuned_on_val"]}
          }
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "status", "source"],
      "properties": {
        "score": {
          "type": "object",
          "additionalProperties": false,
          "required": ["caries_cavitated", "caries_noncavitated"],
          "properties": {
            "caries_cavitated": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
            "caries_noncavitated": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
          }
        },
        "status": {"enum": ["PLACEHOLDER", "set_on_val", "reviewed_by_drg"]},
        "source": {"type": ["string", "null"]}
      }
    },
    "licenses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "weights", "datasets", "model_artifact"],
      "properties": {
        "code": {"$ref": "#/$defs/license_entry"},
        "weights": {"$ref": "#/$defs/license_entry"},
        "datasets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "license"],
            "properties": {"id": {"type": "string"}, "license": {"type": ["string", "null"]}, "url": {"type": ["string", "null"]}, "doi": {"type": ["string", "null"]}}
          }
        },
        "model_artifact": {"type": "string"}
      }
    },
    "attribution": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lang", "text"],
        "properties": {"lang": {"enum": ["id", "en"]}, "text": {"type": "string", "minLength": 1}}
      }
    },
    "int8_parity": {"type": ["object", "null"]},
    "decode_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "version", "reference_impl"],
      "properties": {"document": {"type": "string"}, "version": {"type": "string"}, "reference_impl": {"type": "string"}}
    }
  },
  "allOf": [
    {"if": {"properties": {"output": {"properties": {"format": {"const": "yolox_raw"}}}}},
     "then": {"properties": {"output": {"properties": {"decode": {"$ref": "#/$defs/decode_yolox"}}}}}},
    {"if": {"properties": {"output": {"properties": {"format": {"const": "ssd_raw_anchors"}}}}},
     "then": {"properties": {"output": {"properties": {"decode": {"$ref": "#/$defs/decode_ssd_raw"}}}}}},
    {"if": {"properties": {"output": {"properties": {"format": {"const": "ssd_postprocessed"}}}}},
     "then": {"properties": {"output": {"properties": {"decode": {"$ref": "#/$defs/decode_ssd_post"}}}}}},
    {"if": {"properties": {"output": {"properties": {"format": {"const": "detr_raw"}}}}},
     "then": {"properties": {"output": {"properties": {"decode": {"$ref": "#/$defs/decode_detr"}}}}}},
    {"if": {"properties": {"distribution": {"const": "release"}}},
     "then": {"properties": {
       "validation_status": {"const": "VALIDATED"},
       "thresholds": {"properties": {"status": {"const": "reviewed_by_drg"},
         "score": {"properties": {"caries_cavitated": {"type": "number"}, "caries_noncavitated": {"type": "number"}}}}},
       "licenses": {"properties": {"code": {"properties": {"verified": {"const": true}}}, "weights": {"properties": {"verified": {"const": true}}}}},
       "output": {"properties": {"tensors_verified": {"const": true}}}
     }}}
  ]
}
