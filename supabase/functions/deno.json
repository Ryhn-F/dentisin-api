{
  "tasks": {
    "check": "deno check --quiet _shared/*.ts process-deletion/*.ts retention-sweep/*.ts quota-check/*.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "test": "deno test --no-prompt --allow-env",
    "ci": "deno task check && deno task lint && deno task fmt:check && deno task test"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": { "tags": ["recommended"] }
  },
  "test": {
    "include": ["**/*_test.ts"]
  }
}
