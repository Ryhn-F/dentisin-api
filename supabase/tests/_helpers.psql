-- Shared test helpers, included by every *.test.sql via `\ir _helpers.psql`.
-- Not a test file itself (extension .psql is not picked up by pg_prove).
-- Everything here is created INSIDE the test transaction and rolled back.
--
-- Fixed synthetic identities used across the suite:
--   A  00000000-0000-4000-8000-0000000000a1  guardian
--   B  00000000-0000-4000-8000-0000000000b1  guardian
--   K1 00000000-0000-4000-8000-0000000000c1  kader (facility TST-FAC-1)
--   K2 00000000-0000-4000-8000-0000000000c2  kader (facility TST-FAC-2)
--   FV 00000000-0000-4000-8000-0000000000d1  facility_viewer (TST-FAC-1)
--   AD 00000000-0000-4000-8000-0000000000e1  admin

do $$
begin
  if exists (select 1 from pg_catalog.pg_available_extensions where name = 'pgtap') then
    create extension if not exists pgtap with schema extensions;
    -- Our migrations revoke the default EXECUTE-to-PUBLIC; tests switch roles.
    execute 'grant execute on all functions in schema extensions to anon, authenticated, service_role';
  end if;
end
$$;

create schema if not exists tests;
grant usage on schema tests to anon, authenticated, service_role;

create or replace function tests.new_user(p_id uuid)
returns uuid
language sql
as $$
  insert into auth.users (id, aud, role, email, email_confirmed_at, raw_app_meta_data, raw_user_meta_data)
  values (p_id, 'authenticated', 'authenticated', 'tst-' || p_id::text || '@example.invalid', now(), '{}', '{}')
  returning id
$$;

create or replace function tests.set_claims(p_sub uuid, p_role text)
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims',
                     json_build_object('sub', p_sub, 'role', p_role)::text, true);
  perform set_config('request.jwt.claim.sub', coalesce(p_sub::text, ''), true);
  perform set_config('request.jwt.claim.role', p_role, true);
end
$$;

create or replace function tests.as_user(p_id uuid)
returns void
language plpgsql
as $$
begin
  execute 'reset role';
  perform tests.set_claims(p_id, 'authenticated');
  perform set_config('role', 'authenticated', true);
end
$$;

create or replace function tests.as_anon()
returns void
language plpgsql
as $$
begin
  execute 'reset role';
  perform tests.set_claims(null, 'anon');
  perform set_config('role', 'anon', true);
end
$$;

create or replace function tests.as_service()
returns void
language plpgsql
as $$
begin
  execute 'reset role';
  perform tests.set_claims(null, 'service_role');
  perform set_config('role', 'service_role', true);
end
$$;

create or replace function tests.as_owner()
returns void
language plpgsql
as $$
begin
  execute 'reset role';
  perform tests.set_claims(null, '');
end
$$;

-- Owner-side fixture: child with the given ACTIVE consent types (bypasses sync).
create or replace function tests.make_child(p_owner uuid, p_child uuid, p_consents text[] default array['a', 'b'])
returns uuid
language plpgsql
as $$
declare
  t text;
begin
  insert into public.child_profile (id, owner_id, birth_year, birth_month) values (p_child, p_owner, 2017, 5);
  foreach t in array p_consents loop
    insert into public.consent (child_id, granted_by, consent_type, text_version, granted_at)
    values (p_child, p_owner, t::public.consent_type, 'test-v1', now() - interval '1 day');
  end loop;
  return p_child;
end
$$;

-- Event envelope builder for sync_events.
create or replace function tests.ev(p_event_id uuid, p_type text, p_payload jsonb)
returns jsonb
language sql
immutable
as $$
  select jsonb_build_object('event_id', p_event_id, 'type', p_type, 'payload', p_payload)
$$;

grant execute on all functions in schema tests to anon, authenticated, service_role;

do $$
begin
  perform tests.new_user('00000000-0000-4000-8000-0000000000a1');
  perform tests.new_user('00000000-0000-4000-8000-0000000000b1');
  perform tests.new_user('00000000-0000-4000-8000-0000000000c1');
  perform tests.new_user('00000000-0000-4000-8000-0000000000c2');
  perform tests.new_user('00000000-0000-4000-8000-0000000000d1');
  perform tests.new_user('00000000-0000-4000-8000-0000000000e1');
end
$$;

insert into public.user_role (user_id, role, facility_code) values
  ('00000000-0000-4000-8000-0000000000c1', 'kader', 'TST-FAC-1'),
  ('00000000-0000-4000-8000-0000000000c2', 'kader', 'TST-FAC-2'),
  ('00000000-0000-4000-8000-0000000000d1', 'facility_viewer', 'TST-FAC-1'),
  ('00000000-0000-4000-8000-0000000000e1', 'admin', null);
delete from public.user_role
 where user_id in ('00000000-0000-4000-8000-0000000000d1', '00000000-0000-4000-8000-0000000000e1')
   and role = 'guardian';
