
# --- Supabase (Free, Singapore ap-southeast-1) --------------------------------
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Admin/PC tim saja (export_dataset, uji integrasi). Jangan taruh di app, CI publik, atau log.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (pg_dump / migrasi), mis. postgresql://postgres:<pw>@db.<ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=
SUPABASE_DB_PASSWORD=
# Supabase CLI (supabase link / db push)
SUPABASE_ACCESS_TOKEN=

# --- Auth: SMTP kustom (Resend Free, domain auth.ryhnfir.dev) ------------------
# Host smtp.resend.com, port 465, user "resend", pengirim no-reply@auth.ryhnfir.dev, nama "DentisAI"
RESEND_API_KEY=
# Site URL / redirect (mis. https://app.ryhnfir.dev/auth/callback)
AUTH_SITE_URL=
AUTH_REDIRECT_URL=
# CAPTCHA (hcaptcha | turnstile)
CAPTCHA_PROVIDER=
CAPTCHA_SECRET=

# --- Penandatanganan manifes model/aturan (Ed25519) ----------------------------
# Kunci privat disimpan OFFLINE; di sini hanya jalur ke berkas (kosongkan di CI).
MANIFEST_SIGNING_KEY_PATH=
# Kunci publik (base64, 32 byte) untuk verifikasi/ embed di app
MANIFEST_PUBLIC_KEY_B64=

# --- Backup & keep-alive (Supabase Free: tanpa backup otomatis, dijeda 1 minggu) -
# Kunci PUBLIK age penerima backup (age1...)
BACKUP_AGE_RECIPIENT=
BACKUP_OUTPUT_DIR=
# Endpoint ringan untuk ping terjadwal, mis. ${SUPABASE_URL}/rest/v1/rpc/keepalive
KEEPALIVE_URL=

# --- Azure Speech (TTS build-time, ADR 007; Student, japaneast/japanwest) -------
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# id-ID-GadisNeural | id-ID-ArdiNeural
AZURE_SPEECH_VOICE=

# --- Export dataset berizin (PC tim saja; hanya bila dataset_contribution aktif) -
DATASET_EXPORT_DIR=

SUPABASE_JWT_SECRET=
ENABLE_CLOUD_INFER=false
API_ALLOWED_ORIGINS=

# --- Gemini API TTS (ADR 010; build-time saja, naskah statis) -------------------
GEMINI_API_KEY=
# mis. gemini-2.5-flash-preview-tts (cek model terbaru di dokumentasi)
GEMINI_TTS_MODEL=
# nama suara prebuilt, mis. Kore
GEMINI_TTS_VOICE=

# --- Tambahan (TTS & manifes) --------------------------------------------------
# Penyedia TTS: gemini (default, ADR 010) | azure (cadangan; AZURE_SPEECH_* di atas jadi opsional)
TTS_PROVIDER=gemini
# Opsional: gaya bicara (mis. "tenang, ramah, jelas"); kosongkan bila tidak dipakai
GEMINI_TTS_STYLE=
# Opsional: ganti jalur naskah TTS (default: tools/tts/script.sample.csv butuh --allow-sample)
TTS_SCRIPT_PATH=

# Bearer secret untuk Edge Functions terjadwal (process-deletion, retention-sweep); simpan juga di GitHub Actions secrets
CRON_SECRET=
