    {"path": "ml/detection/tests/decode_vectors.json", "component": "detection", "role": "parity"},
    {"path": "ml/detection/quality_gate.yaml", "component": "quality_gate", "role": "artifact"},
    {"path": "ml/detection/tests/quality_gate_vectors.json", "component": "quality_gate", "role": "parity"},

    {"path": "ml/brushing/brushing_rules.yaml", "component": "brushing", "role": "artifact"},
