    {"path": "recommender/dist/recommender.json", "component": "recommender", "role": "artifact"},
    {"path": "recommender/dist/recommender.json.sha256", "component": "recommender", "role": "checksum"},
    {"path": "recommender/tests/cases.json", "component": "recommender", "role": "parity"},

    {"path": "tools/manifest/SPEC.md", "component": "manifest", "role": "spec"},
    {"path": "tools/manifest/vectors/canonicalization.json", "component": "manifest", "role": "parity"},
    {"path": "tools/manifest/vectors/manifest_v1_valid_01_minimal.json", "component": "manifest", "role": "parity"},
