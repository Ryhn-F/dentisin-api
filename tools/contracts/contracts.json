    {"path": "tools/manifest/vectors/manifest_v1_valid_03_escapes_and_semver.json", "component": "manifest", "role": "parity"},
    {"path": "tools/manifest/vectors/manifest_v1_invalid.json", "component": "manifest", "role": "parity"},

    {"path": "ml/detection/DECODE_SPEC.md", "component": "detection", "role": "spec"},
