# Context = backend/ (see Dockerfile). Deny everything, then admit only what the image needs.
# Never admits .env*, keys, photos, datasets, training runs, tests (except the shared
# triage case table the release gate counts), caches or virtualenvs. Model weights only as
# released export bundles in ml/exports/<semver> (ADR 020).
*
!api/pyproject.toml
!api/uv.lock
!api/app/
!triage/pyproject.toml
!triage/rules.yaml
!triage/schema.json
!triage/src/
!triage/dist/
!triage/tests/cases.json
!recommender/pyproject.toml
!recommender/*.py
!recommender/rules.json
!recommender/products.json
!recommender/schema/
!ml/detection/quality_gate.py
!ml/detection/quality_gate.yaml
!ml/detection/canonical.py
!ml/detection/decode.py
!ml/detection/preprocess.py
!ml/exports/*/model.tflite
!ml/exports/*/labels.json
!ml/exports/*/MODEL_CARD.md
!ml/exports/*/SHA256
!docs/style/forbidden_phrases.md
**/__pycache__
**/*.pyc
**/.venv
**/*.egg-info
**/.env*
**/*.pem
**/*.key
