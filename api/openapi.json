        "summary": "List pending review items (reviewer/admin), keyset-paginated",
        "tags": [
          "review-queue"
        ]
      },
      "post": {
        "operationId": "enqueue_v1_ml_review_queue_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnqueueRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnqueueResponse"
                }
              }
            },
            "description": "Already queued (idempotent)."
          },
          "201": {
            "content": {
